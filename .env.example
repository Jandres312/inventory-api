#Este archivo es una plantilla que le dice a otros desarrolladores: "necesitas estas variables de entorno para que funcione". El archivo .env real (con las credenciales verdaderas) nunca se sube al repositorio por temas de seguridad
# Configuracion de la base de datos
DATABASE_URL=postgresql://postgres:postgres@db:5432/inventory

# Puerto de la aplicacion
APP_PORT=8000

# Credenciales de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory

